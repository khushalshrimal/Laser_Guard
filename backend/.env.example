# LaserGuard AI Backend Environment Configuration
# Copy this file to .env for local configuration

HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info

# In-Memory Stale Data Detection Threshold (seconds)
# Devices with no valid telemetry reception within this duration transition from ONLINE to STALE
STALE_THRESHOLD_SECONDS=10.0

# Safety Rules Engine Thresholds (Demo Settings — Calibrate before production)
# High workpiece/chamber temperature warning threshold in Celsius (°C)
HIGH_TEMP_THRESHOLD_C=60.0

# Elevated smoke/particulate index warning threshold
ELEVATED_SMOKE_THRESHOLD=50.0

# SQLite Blackbox Audit Event Store Configuration
# Persistent SQLite database location (git-ignored data directory)
DATABASE_PATH=data/laserguard_blackbox.db

# Maximum number of audit events retained before pruning oldest records (range: 100 - 1000000)
MAX_EVENTS_RETAINED=10000

